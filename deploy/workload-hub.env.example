APP_ADDR=127.0.0.1:8080
APP_DB=/var/lib/workload-hub/workload.db
APP_BACKUP_DIR=/var/backups/workload-hub
APP_COOKIE_SECURE=true
APP_BASE_URL=https://workload.example.com
APP_TIMEZONE=Asia/Shanghai


# 阿里云盘异地备份：部署时以workload-hub用户运行aliyunpan login完成网页OAuth及扫码授权。
# 关闭时只执行VPS本地三份滚动备份。
APP_ALIDRIVE_ENABLED=false
APP_ALIDRIVE_CLI_BIN=/usr/local/bin/aliyunpan
APP_ALIDRIVE_CONFIG_DIR=/var/lib/workload-hub/aliyunpan
APP_ALIDRIVE_PATH=/载衡人力负荷备份
